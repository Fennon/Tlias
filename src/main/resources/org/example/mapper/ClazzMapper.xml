<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.mapper.ClazzMapper">

    <select id="pageSelect" resultType="org.example.pojo.Clazz">
        select c.*, e.name master_name
        from clazz c
        left join emp e on c.master_id = e.id
        <where>
            <if test="name != null and name != ''">
                c.name like concat('%', #{name}, '%')
            </if>
            <if test="begin != null">
                and c.begin_date >= #{begin}
            </if>
            <if test="end != null">
                and c.end_date &lt;= #{end}
            </if>
        </where>
        order by c.update_time desc
    </select>
</mapper>